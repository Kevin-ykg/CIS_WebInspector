<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CIS_WebInspector</RootNamespace>
    <AssemblyName>CIS_WebInspector</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- C# Debug 也用优化后的算法库；混合断点调试时显式指定 VisionNativeConfiguration=Debug。 -->
    <VisionNativeConfiguration Condition="'$(VisionNativeConfiguration)' == ''">Release</VisionNativeConfiguration>
    <!--
      WPF/Visual Studio 可能同时生成 obj\Debug、obj\x64 和嵌套探针的 obj。
      SDK 默认只保证排除当前 BaseIntermediateOutputPath；显式排除任意层级的 bin/obj，
      防止其他配置生成的 AssemblyInfo.cs 被默认源码通配符再次编译。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VolansGrabberCL_net">
      <HintPath>..\..\lib\x64\VolansGrabberCL_net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.*" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.*" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.*" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\QrRegression\**\*.cs" />
    <Resource Include="logo.png" />
    <None Update="Assets\WeChatQRCode\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="obj\VisionNative\core-build\$(VisionNativeConfiguration)\CISVisionCore.dll" Link="CISVisionCore.dll"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Native\licenses\**\*" Link="ThirdPartyLicenses\CISVisionCore\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Post-build: copy all native DLLs to output directory -->
  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <Error Condition="!Exists('obj\VisionNative\core-build\$(VisionNativeConfiguration)\CISVisionCore.dll')"
           Text="缺少 CISVisionCore.dll，请先运行 Tools\Build-VisionNative.ps1 构建 C++ 二维码算法库。" />
    <Copy SourceFiles="obj\VisionNative\core-build\$(VisionNativeConfiguration)\CISVisionCore.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\lib\x64\VolansGrabberCL.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="TLC_SDK_C++_64位\tlc.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\lib\x64\CamExpRemote.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
